# Pin Constraint File for iCE40-HX8K Breakout Board
# Lattice HX8K-B-EVN board pinout

# 12 MHz Clock Input
set_io clk_12mhz J3

# Reset Button (active low)
# Using one of the buttons on the board
set_io rst_n_btn P16

# LED Outputs (8 LEDs)
# D1-D8 on the HX8K breakout board
set_io led[0] B5
set_io led[1] B4
set_io led[2] A2
set_io led[3] A1
set_io led[4] C5
set_io led[5] C4
set_io led[6] B3
set_io led[7] C3
